---
import { Image } from 'astro:assets';
import { themeConfig } from '../config';
import { __, formatDate } from '../i18n';
import { getExcerpt, normalizePostCover, type Post } from '../utils/collections';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { data } = post;

const cover = normalizePostCover(data);
const showCover = cover !== false;
// 封面位置：top（默认，上下排布）| left | right
const coverPosition = data.coverPosition === 'left' || data.coverPosition === 'right' ? data.coverPosition : 'top';

const excerpt = getExcerpt(post, themeConfig.home.excerpt_length);

const dateFormat =
	themeConfig.home.article_date_format === 'auto' || themeConfig.home.article_date_format === 'relative'
		? 'YYYY-MM-DD'
		: themeConfig.home.article_date_format;
const dateText = formatDate(data.pubDate, dateFormat);

const categories = Array.isArray(data.categories)
	? data.categories
	: data.categories
		? [data.categories]
		: [];
const tags = Array.isArray(data.tags) ? data.tags : data.tags ? [data.tags] : [];

const catLimit = themeConfig.home.categories.limit;
const tagLimit = themeConfig.home.tags.limit;

const categoryUrl = (cat: string) => `/categories/${cat.split('/').map(encodeURIComponent).join('/')}/`;
const tagUrl = (tag: string) => `/tags/${encodeURIComponent(tag.toLowerCase())}/`;

const postUrl = `/blog/${post.id}/`;
---

<li
	data-home-card
	class:list={[
		'relative flex box-border mb-6 flex-col overflow-hidden rounded-2xl ring-inset ring ring-rd-gray-alpha-400 bg-rd-background-100 sm:mb-8 md:mb-10 group',
	]}
>
	{
		data.sticky && (
			<div data-sticky-label class="absolute top-3 right-3 z-10 cursor-default rounded-full border border-rd-gray-alpha-400 bg-rd-background-100/15 px-2.5 py-0.5 text-xs text-rd-gray-900 hover:text-rd-gray-1000">
				<i class="fa-regular fa-thumbtack mr-1 text-xs" aria-hidden="true"></i>{__('sticky')}
			</div>
		)
	}

	{
		showCover && coverPosition === 'top' && (
			<div class="relative -mb-1 h-40 w-full shrink-0 overflow-hidden">
				<a href={postUrl}>
					{typeof cover === 'string' ? (
						<img src={cover} alt={data.title} class="absolute top-1/2 h-full w-full -translate-y-1/2 object-cover transition-all dark:brightness-75 group-hover:scale-102 duration-500" />
					) : (
						<Image src={cover} alt={data.title} class="absolute top-1/2 h-full w-full -translate-y-1/2 object-cover transition-all dark:brightness-75 group-hover:scale-102 duration-500" />
					)}
				</a>
			</div>
		)
	}

	{
		showCover && (coverPosition === 'left' || coverPosition === 'right') && (
			<div
				class:list={[
					'absolute inset-y-0 w-2/5 overflow-hidden sm:w-1/3',
					coverPosition === 'left' ? 'left-0' : 'right-0',
				]}
			>
				<a href={postUrl} class="block h-full w-full">
					{typeof cover === 'string' ? (
						<img src={cover} alt={data.title} class="h-full w-full object-cover transition-all dark:brightness-75 group-hover:scale-102 duration-500" />
					) : (
						<Image src={cover} alt={data.title} class="h-full w-full object-cover transition-all dark:brightness-75 group-hover:scale-102 duration-500" />
					)}
				</a>
			</div>
		)
	}

	<div
		class:list={[
			'flex flex-col gap-4 p-6',
			showCover && coverPosition === 'left' && 'pl-[calc(40%+1.5rem)] sm:pl-[calc(33.333%+1.5rem)]',
			showCover && coverPosition === 'right' && 'pr-[calc(40%+1.5rem)] sm:pr-[calc(33.333%+1.5rem)]',
		]}
	>
		<h3 class="relative m-0 font-[family-name:var(--font-article-title)] text-xl leading-normal font-semibold text-rd-gray-1000 sm:text-xl">
			<a href={postUrl}>{data.title}</a>
		</h3>

		<div class="markdown-body text-justify text-rd-gray-1000 [overflow-wrap:break-word]">
			{excerpt}
		</div>

		<div class="flex items-center justify-between text-sm text-rd-gray-900">
			<div class="tracking-normal [&_a]:text-rd-gray-900 [&_a:hover]:text-primary">
				<span class="mr-2.5">
					<i class="fa-solid fa-calendars" aria-hidden="true"></i>&nbsp;
					<time data-home-article-date data-date={data.pubDate.toISOString()} datetime={data.pubDate.toISOString()}>
						{dateText}
					</time>
				</span>
				{
					categories.length > 0 &&
					themeConfig.home.categories.enable && (
						<span class="mr-2.5 hidden sm:inline">
							<i class="fa-solid fa-folders" aria-hidden="true"></i>&nbsp;
							<ul class="inline">
								{categories.slice(0, catLimit === 0 ? undefined : catLimit).map((cat, i) => (
									<li class="inline">
										{i > 0 && <span class="text-rd-gray-900"> | </span>}
										<a href={categoryUrl(cat)}>{cat}</a>&nbsp;
									</li>
								))}
							</ul>
						</span>
					)
				}
				{
					tags.length > 0 &&
					themeConfig.home.tags.enable && (
						<span class="mr-2.5 hidden last:mr-0 md:inline">
							<i class="fa-solid fa-tags" aria-hidden="true"></i>&nbsp;
							<ul class="inline">
								{tags.slice(0, tagLimit === 0 ? undefined : tagLimit).map((tag, i) => (
									<li class="inline">
										{i > 0 && <span class="text-rd-gray-900"> | </span>}
										<a href={tagUrl(tag)}>{tag}</a>&nbsp;
									</li>
								))}
							</ul>
						</span>
					)
				}
			</div>

			<a class="group/read-more -my-2 flex items-center gap-2 py-2" href={postUrl}>
				{__('read_more')}
				<span class="sr-only">{data.title}</span>
				<i class="fa-regular fa-angle-right group-hover/read-more:translate-x-0.5 transition-transform" aria-hidden="true"></i>
			</a>
		</div>
	</div>
</li>
