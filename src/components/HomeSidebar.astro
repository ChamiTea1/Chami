---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { siteConfig, themeConfig } from '../config';
import { __, formatDate } from '../i18n';
import { getCategories, getTags, getWordCount, normalizePostCover, sortPosts } from '../utils/collections';

const posts = sortPosts(await getCollection('blog'));
const tags = getTags(posts);
const categories = getCategories(posts);
const siteWordCount = posts.reduce((sum, post) => sum + getWordCount(post.body ?? '').words, 0);
const sidebar = themeConfig.home.sidebar;
const announcement =
	typeof sidebar.announcement === 'string' && sidebar.announcement.trim() ? sidebar.announcement : null;
const recentPosts = posts.slice(0, 5);

const sidebarPosition = sidebar.position === 'right' ? 'order-last' : 'order-first';

// 标签云字号分档
const tagCounts = [...new Set(tags.map((tag) => tag.count))];
const minCount = tagCounts.length ? Math.min(...tagCounts) : 1;
const maxCount = tagCounts.length ? Math.max(...tagCounts) : 1;
const tagSize = (count: number) =>
	tagCounts.length <= 1 ? 1.05 : 0.95 + ((count - minCount) / Math.max(1, maxCount - minCount)) * 0.5;

// 归档（年份 + 篇数）
const years = [...new Set(posts.map((post) => post.data.pubDate.getFullYear()))].sort((a, b) => b - a);

const recentPostDate = (post: (typeof posts)[number]) => formatDate(post.data.pubDate, 'YYYY-MM-DD');
const recentCover = (post: (typeof posts)[number]) => {
	const cover = normalizePostCover(post.data);
	return typeof cover === 'string' ? cover : cover && typeof cover === 'object' && 'src' in cover ? cover : null;
};
---

<aside
	class:list={[
		sidebarPosition,
		'hidden w-60 shrink-0 md:block',
		'sticky post-home-aside',
	]}
>
	{/* 作者卡片 */}
	<div class="rounded-2xl border border-rd-gray-alpha-400 bg-rd-background-100 p-5 shadow-rd">
		<div class="flex flex-col items-center">
			<img
				src={themeConfig.defaults.avatar}
				alt={siteConfig.author}
				class="size-28 rounded-full border border-rd-gray-alpha-400 object-cover"
			/>
			<div class="mt-3 text-center text-2xl font-bold text-rd-gray-1000">{siteConfig.author}</div>
			<div class="mt-1.5 text-center text-sm text-rd-gray-900">{siteConfig.subtitle}</div>
		</div>
	</div>

	{/* 公告卡片 */}
	{
		announcement && (
			<div class="mt-5 rounded-2xl border border-rd-gray-alpha-400 bg-rd-background-100 p-5 shadow-rd">
				<div class="flex items-center gap-1.5">
					<i class="fa-regular fa-bullhorn text-rd-gray-900" aria-hidden="true"></i>
					<span class="text-sm font-bold text-rd-gray-1000">{__('announcement')}</span>
				</div>
				<div class="mt-2.5 text-sm leading-relaxed text-rd-gray-900">{announcement}</div>
			</div>
		)
	}

	{/* 分类卡片 */}
	{
		categories.length > 0 && (
			<div class="mt-5 rounded-2xl border border-rd-gray-alpha-400 bg-rd-background-100 p-5 shadow-rd">
				<div class="flex items-center gap-1.5">
					<i class="fa-regular fa-folder-open text-rd-gray-900" aria-hidden="true"></i>
					<span class="text-sm font-bold text-rd-gray-1000">{__('categories')}</span>
				</div>
				<ul class="mt-2.5 flex flex-col gap-1">
					{categories.map((category) => (
						<li>
							<a
								href={`/categories/${category.path.split('/').map(encodeURIComponent).join('/')}/`}
								class="group flex items-center justify-between rounded-lg px-2 py-1 text-sm text-rd-gray-1000 transition-colors hover:!bg-rd-gray-200/50 hover:!text-primary"
							>
								<span class="truncate">{category.name}</span>
								<span class="ml-2 shrink-0 text-xs text-rd-gray-900">{category.count}</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		)
	}

	{/* 标签云 / 归档 / 网站资讯 / 最新文章 */}
	<div class="mt-5 flex flex-col gap-5">
		{
			tags.length > 0 && (
				<div class="rounded-2xl border border-rd-gray-alpha-400 bg-rd-background-100 p-5 shadow-rd">
					<div class="flex items-center gap-1.5">
						<i class="fa-regular fa-tags text-rd-gray-900" aria-hidden="true"></i>
						<span class="text-sm font-bold text-rd-gray-1000">{__('tags')}</span>
					</div>
					<div class="mt-2.5 flex flex-wrap gap-x-2 gap-y-1.5">
						{tags.map((tag) => (
							<a
								href={`/tags/${encodeURIComponent(tag.slug)}/`}
								class="inline-flex items-baseline rounded px-1 text-rd-gray-1000 transition-colors hover:!text-primary"
								style={`font-size: ${tagSize(tag.count).toFixed(2)}rem`}
							>
								{tag.name}
								<sup class="ml-0.5 text-[0.65em] text-rd-gray-900">{tag.count}</sup>
							</a>
						))}
					</div>
				</div>
			)
		}

		{
			years.length > 0 && (
				<div class="rounded-2xl border border-rd-gray-alpha-400 bg-rd-background-100 p-5 shadow-rd">
					<div class="flex items-center gap-1.5">
						<i class="fa-regular fa-archive text-rd-gray-900" aria-hidden="true"></i>
						<span class="text-sm font-bold text-rd-gray-1000">{__('archive')}</span>
					</div>
					<ul class="mt-2.5 flex flex-col gap-1">
						{years.map((year) => {
							const count = posts.filter((post) => post.data.pubDate.getFullYear() === year).length;
							return (
								<li>
									<a
										href="/archives/"
										class="group flex items-center justify-between rounded-lg px-2 py-1 text-sm text-rd-gray-1000 transition-colors hover:!bg-rd-gray-200/50 hover:!text-primary"
									>
										<span>{year}</span>
										<span class="ml-2 shrink-0 text-xs text-rd-gray-900">{count}</span>
									</a>
								</li>
							);
						})}
					</ul>
				</div>
			)
		}

		{/* 网站资讯卡片 */}
		<div class="rounded-2xl border border-rd-gray-alpha-400 bg-rd-background-100 p-5 shadow-rd">
			<div class="flex items-center gap-1.5">
				<i class="fa-regular fa-chart-line text-rd-gray-900" aria-hidden="true"></i>
				<span class="text-sm font-bold text-rd-gray-1000">{__('webinfo')}</span>
			</div>
			<ul class="mt-2.5 flex flex-col gap-2">
				<li class="flex items-center justify-between text-sm">
					<span class="flex items-center gap-1.5 text-rd-gray-900">
						<i class="fa-regular fa-file-lines text-xs" aria-hidden="true"></i>
						{__('total_posts')}
					</span>
					<span class="font-mono text-rd-gray-1000">{posts.length}</span>
				</li>
				<li class="flex items-center justify-between text-sm">
					<span class="flex items-center gap-1.5 text-rd-gray-900">
						<i class="fa-regular fa-stopwatch text-xs" aria-hidden="true"></i>
						{__('site_days')}
					</span>
					<span class="font-mono text-rd-gray-1000" id="sidebar-runtime-days">-</span>
				</li>
				<li class="flex items-center justify-between text-sm">
					<span class="flex items-center gap-1.5 text-rd-gray-900">
						<i class="fa-regular fa-font text-xs" aria-hidden="true"></i>
						{__('total_words')}
					</span>
					<span class="font-mono text-rd-gray-1000">{siteWordCount}</span>
				</li>
				{
					themeConfig.global.website_counter.enable && (
						<>
							{themeConfig.global.website_counter.site_uv && (
								<li class="flex items-center justify-between text-sm">
									<span class="flex items-center gap-1.5 text-rd-gray-900">
										<i class="fa-regular fa-user-group text-xs" aria-hidden="true"></i>
										{__('site_uv')}
									</span>
									<span class="font-mono text-rd-gray-1000" id="busuanzi_value_site_uv"></span>
								</li>
							)}
							{themeConfig.global.website_counter.site_pv && (
								<li class="flex items-center justify-between text-sm">
									<span class="flex items-center gap-1.5 text-rd-gray-900">
										<i class="fa-regular fa-eye text-xs" aria-hidden="true"></i>
										{__('site_pv')}
									</span>
									<span class="font-mono text-rd-gray-1000" id="busuanzi_value_site_pv"></span>
								</li>
							)}
						</>
					)
				}
			</ul>
		</div>

		{/* 最新文章卡片 */}
		{
			recentPosts.length > 0 && (
				<div class="rounded-2xl border border-rd-gray-alpha-400 bg-rd-background-100 p-5 shadow-rd">
					<div class="flex items-center gap-1.5">
						<i class="fa-regular fa-history text-rd-gray-900" aria-hidden="true"></i>
						<span class="text-sm font-bold text-rd-gray-1000">{__('recent_posts')}</span>
					</div>
					<ul class="mt-2.5 flex flex-col">
						{recentPosts.map((post) => {
							const cover = recentCover(post);
							return (
								<li class:list={['group flex items-center gap-2.5 py-1.5', 'border-b border-dashed border-rd-gray-alpha-400 last:border-b-0']}>
									{typeof cover === 'string' ? (
										<img
											src={cover}
											alt={post.data.title}
											class="size-10 shrink-0 rounded-lg border border-rd-gray-alpha-400 object-cover"
										/>
									) : cover && typeof cover === 'object' && 'src' in cover ? (
										<Image
											src={cover}
											alt={post.data.title}
											class="size-10 shrink-0 rounded-lg border border-rd-gray-alpha-400 object-cover"
										/>
									) : (
										<span class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-rd-gray-alpha-400 bg-rd-gray-100">
											<i class="fa-regular fa-file-lines text-xs text-rd-gray-900" aria-hidden="true"></i>
										</span>
									)}
									<div class="min-w-0">
										<a
											href={`/blog/${post.id}/`}
											class="line-clamp-2 text-sm leading-snug text-rd-gray-1000 transition-colors group-hover:!text-primary"
										>
											{post.data.title}
										</a>
										<time datetime={post.data.pubDate.toISOString()} class="mt-0.5 block text-xs text-rd-gray-900">
											{recentPostDate(post)}
										</time>
									</div>
								</li>
							);
						})}
					</ul>
				</div>
			)
		}
	</div>
</aside>
