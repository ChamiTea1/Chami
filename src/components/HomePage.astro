---
import { themeConfig } from '../config';
import HomeSidebar from './HomeSidebar.astro';
import Paginator from './Paginator.astro';
import PostCard from './PostCard.astro';
import type { Post } from '../utils/collections';

interface Props {
	posts: Post[];
	current: number;
	total: number;
}

const { posts, current, total } = Astro.props;
---

<div class="flex w-9/10 items-start justify-center gap-10 sm:w-6/7">
	{themeConfig.home.sidebar.enable === true && <HomeSidebar />}

	<div
		id="main-content"
		class="relative h-full min-w-0 flex-1 max-w-content transition-[max-width,width] duration-200 ease-in-out"
	>
		<ul>
			{posts.map((post) => (
				<PostCard post={post} />
			))}
		</ul>

		<div class="px-7 py-5">
			<Paginator current={current} total={total} baseUrl="/" />
		</div>
	</div>
</div>
