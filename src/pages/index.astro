---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBanner from '../components/HomeBanner.astro';
import HomePage from '../components/HomePage.astro';
import { themeConfig } from '../config';
import { sortPosts, POSTS_PER_PAGE } from '../utils/collections';

const posts = sortPosts(await getCollection('blog'));
const total = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const pagePosts = posts.slice(0, POSTS_PER_PAGE);
---

<BaseLayout isHome>
	{themeConfig.home_banner.enable && <HomeBanner slot="banner" />}
	<HomePage posts={pagePosts} current={1} total={total} />
</BaseLayout>
