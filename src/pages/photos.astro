---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import SideCard from '../components/SideCard.astro';
import { __ } from '../i18n';
import albumsData from '../data/masonry.json';

interface MasonryItem {
	image?: string;
	title?: string;
	description?: string;
	width?: number;
	height?: number;
	exif?: boolean;
}

interface MasonryAlbum {
	name: string;
	slug: string;
	cover?: string;
	description?: string;
	items?: MasonryItem[];
}

const albums = (albumsData as unknown as MasonryAlbum[]).filter((album) => album.slug && album.name);

interface FanImage {
	image: string;
	alt: string;
	x: number;
	y: number;
	rot: number;
	cx: number;
	cy: number;
	arcRot: number;
	delay: number;
}

const RAD = Math.PI / 180;

/**
 * 取相册最多 5 张图：默认扇形堆叠；悬停时像折扇一样张开——
 * 铰链圆心 P 在卡片底边下方，所有底边相切于该铰链圆（半径 hingeR），
 * 每张扇骨沿圆依次滑动 30°，展开成 120° 的扇形。
 * 最左一张完全钉死在原地（展开角 theta0 取其静止倾角，展开位 == 静止位），
 * 其余从最右开始沿切线圆向右单侧展开、依次滑出。
 * --x/--y/--rot 为静止姿态；--cx/--cy/--arc-rot 为张开后的位置与旋转角。
 */
const fanFor = (album: MasonryAlbum): FanImage[] => {
	const images = (album.items ?? []).filter((item) => item.image);
	if (images.length === 0) return [];
	const count = Math.min(5, images.length);
	const cardHalfH = 84; // 卡片高 10.5rem 的一半（中心到底边中点）
	const hingeR = 30; // 底边公共切线圆（铰链）半径，圆心在底边下方
	const step = 30; // 每张沿铰链圆滑动 30°
	const stagger = 70; // 从最右边开始，向左每张延迟 70ms

	// 最左卡片的静止姿态（完全钉在原地：展开角 = 静止倾角，展开位 == 静止位）
	const t0 = -(count - 1) / 2;
	const x0 = t0 * 30;
	const y0 = 8;
	const theta0 = t0 * 14; // 张开后最左扇骨的角度，与静止姿态 rot 一致

	// 反解铰链圆心 P：card 中心 = P + (hingeR + cardHalfH) · (sinθ, -cosθ)
	const arm = hingeR + cardHalfH;
	const px = x0 - arm * Math.sin(theta0 * RAD);
	const py = y0 + arm * Math.cos(theta0 * RAD);

	const fan: FanImage[] = [];
	for (let i = 0; i < count; i++) {
		const index = count === 1 ? 0 : Math.round((i * (images.length - 1)) / (count - 1));
		const t = i - (count - 1) / 2;
		const theta = (theta0 + i * step) * RAD;
		fan.push({
			image: images[index].image as string,
			alt: images[index].title || album.name,
			x: t * 30,
			y: 8,
			rot: t * 14,
			cx: Math.round(px + arm * Math.sin(theta)),
			cy: Math.round(py - arm * Math.cos(theta)),
			arcRot: Math.round((theta / RAD) * 10) / 10,
			delay: (count - 1 - i) * stagger,
		});
	}
	return fan;
};

const title = __('photos');
const coverPool = albums.map((album) => album.cover).filter(Boolean) as string[];
const bannerCover = coverPool[0];

const albumCount = albums.length;
const photoCount = albums.reduce((sum, album) => sum + (album.items?.length ?? 0), 0);
const photosPool = albums.flatMap((album) =>
	(album.items ?? [])
		.filter((item) => item.image)
		.map((item) => ({
			image: item.image as string,
			title: item.title || album.name,
			albumName: album.name,
			slug: album.slug,
		})),
);
const firstPhoto = photosPool[0];
// 约定：masonry.json 数组最前为最新（见 AGENTS.md）
const recentAlbums = albums.slice(0, 3);
---

<BaseLayout title={title}>
	{
		bannerCover && (
			<div slot="banner" aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
				<img
					id="photos-banner-img"
					src={bannerCover}
					alt=""
					data-covers={JSON.stringify(coverPool)}
					class="h-full w-full scale-125 object-cover blur-[16px] dark:brightness-75 dark:saturate-[0.85]"
				/>
				<div class="page-banner-overlay page-banner-overlay-light dark:hidden"></div>
				<div class="page-banner-overlay page-banner-overlay-dark hidden dark:block"></div>
			</div>
		)
	}
	<div id="main-content" class="relative box-border h-full w-9/10 max-w-content transition-[max-width,width] duration-200 ease-in-out sm:w-6/7 md:w-4/5">
		<div class="flex items-start justify-center gap-24">
			<div class="min-w-0 flex-1">
				<div class="py-8 sm:py-0">
					<PageTitle title={title} showBorder />
					{
						albums.length > 0 ? (
							<ul class="grid grid-cols-1 gap-[30px] sm:grid-cols-2 lg:grid-cols-3">
								{albums.map((album) => (
									<li>
										<a
											href={`/photos/${album.slug}/`}
											class="group flex flex-col"
										>
											{
												(() => {
													const fan = fanFor(album);
													return fan.length > 0 ? (
														<div class="album-fan flex justify-center" aria-hidden="true">
															{fan.map((img, i) => (
																<img
																	src={img.image}
																	alt={img.alt}
																	loading="lazy"
																	decoding="async"
																	style={`--x: ${img.x}px; --y: ${img.y}px; --rot: ${img.rot}deg; --cx: ${img.cx}px; --cy: ${img.cy}px; --arc-rot: ${img.arcRot}deg; --delay: ${img.delay}ms; z-index: ${i + 1};`}
																/>
															))}
														</div>
													) : (
														<div class="flex aspect-[4/3] w-full items-center justify-center bg-rd-gray-100">
															<i class="fa-regular fa-images text-3xl text-rd-gray-900" aria-hidden="true"></i>
														</div>
													);
												})()
											}
											<div class="flex flex-col items-center gap-1 p-4 text-center">
												<span class="text-lg font-bold text-rd-gray-1000 transition-colors group-hover:!text-primary">{album.name}</span>
												<span class="text-xs text-rd-gray-900">{__('photos_count', String(album.items?.length ?? 0))}</span>
												{album.description && <p class="line-clamp-2 text-sm text-rd-gray-900">{album.description}</p>}
											</div>
										</a>
									</li>
								))}
							</ul>
						) : (
							<p class="py-10 text-center text-sm text-rd-gray-900">{__('photos_empty')}</p>
						)
					}
				</div>
			</div>

			<aside class="page-sidebar fixed right-[150px] top-[calc(var(--current-navbar-height)+1rem)] hidden w-60 min-[1780px]:block">
				<div class="sticky top-[calc(var(--current-navbar-height)+1rem)] mt-12 flex flex-col gap-6">
					<SideCard icon="fa-regular fa-chart-simple" title={__('photos_stats')}>
						<p class="text-sm text-rd-gray-900">{__('photos_stats_count', String(albumCount), String(photoCount))}</p>
					</SideCard>

					{
						firstPhoto && (
							<SideCard icon="fa-regular fa-dice" title={__('photos_blindbox')}>
								<a id="photos-blindbox-link" href={`/photos/${firstPhoto.slug}/`} class="group block">
									<div class="overflow-hidden rounded-xl border border-rd-gray-alpha-400">
										<img
											id="photos-blindbox-img"
											src={firstPhoto.image}
											alt={firstPhoto.title}
											loading="lazy"
											decoding="async"
											class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-105"
										/>
									</div>
									<div class="mt-2 flex flex-col">
										<span id="photos-blindbox-title" class="truncate text-sm font-medium text-rd-gray-1000 group-hover:!text-primary">{firstPhoto.title}</span>
										<span id="photos-blindbox-album" class="text-xs text-rd-gray-900">{firstPhoto.albumName}</span>
									</div>
								</a>
								<p class="mt-2 text-xs text-rd-gray-900">{__('photos_blindbox_hint')}</p>
							</SideCard>
						)
					}

					{
						recentAlbums.length > 0 && (
							<SideCard icon="fa-regular fa-clock" title={__('photos_recent')}>
								<ul class="flex flex-col gap-2">
									{recentAlbums.map((album) => (
										<li>
											<a href={`/photos/${album.slug}/`} class="flex items-center justify-between gap-2 text-sm text-rd-gray-1000 transition-colors hover:!text-primary">
												<span class="truncate">{album.name}</span>
												<span class="shrink-0 text-xs text-rd-gray-900">{album.items?.length ?? 0}</span>
											</a>
										</li>
									))}
								</ul>
							</SideCard>
						)
					}
				</div>
			</aside>
		</div>
	</div>
</BaseLayout>

<script type="application/json" id="photos-pool-data" set:html={JSON.stringify(photosPool)}></script>

<style>
	/* 子相册封面：默认多图扇形堆叠；悬停时整体上浮与扇形展开同时进行——
	   沿底边公共切线圆向右单侧展开：最左一张相对扇面不动，
	   其余每张 +30°，从最右边开始依次滑出 */
	.album-fan {
		position: relative;
		height: 13rem;
		margin-top: 0.5rem;
		overflow: visible;
		transition: transform 0.55s cubic-bezier(0.33, 1.15, 0.45, 1);
	}

	.album-fan:hover {
		z-index: 30;
		transform: translateY(-14px); /* 与展开同步的整体上浮 */
	}

	.album-fan img {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 8rem;
		height: 10.5rem;
		object-fit: cover;
		border-radius: 0.9rem;
		box-shadow: 0 6px 18px rgb(0 0 0 / 12%);
		transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y))) rotate(var(--rot));
		transform-origin: 50% 50%;
		transition:
			transform 0.55s cubic-bezier(0.33, 1.15, 0.45, 1),
			box-shadow 0.55s ease;
	}

	.album-fan:hover img {
		transform: translate(calc(-50% + var(--cx)), calc(-50% + var(--cy))) rotate(var(--arc-rot));
		box-shadow: 0 16px 32px rgb(0 0 0 / 22%);
		/* 与上浮同时开始展开，仍从最右开始依次滑出 */
		transition-delay: var(--delay, 0ms);
	}
</style>
