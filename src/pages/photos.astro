---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import { __ } from '../i18n';
import albumsData from '../data/masonry.json';

interface MasonryItem {
	image?: string;
	title?: string;
	description?: string;
	width?: number;
	height?: number;
	exif?: boolean;
}

interface MasonryAlbum {
	name: string;
	slug: string;
	cover?: string;
	description?: string;
	items?: MasonryItem[];
}

const albums = (albumsData as unknown as MasonryAlbum[]).filter((album) => album.slug && album.name);

interface FanImage {
	image: string;
	alt: string;
	x: number;
	y: number;
	rot: number;
	cx: number;
	cy: number;
	wheelRot: number;
}

/**
 * 取相册最多 5 张图：默认扇形堆叠；悬停时浮起、围绕圆心展开成「摩天轮」圆环——
 * 每张图旋转到圆周切线方向（底部图片倒置）。
 * --x/--y/--rot 为扇形姿态，--cx/--cy 为圆形位置，--wheel-rot 为环上切线旋转角。
 */
const fanFor = (album: MasonryAlbum): FanImage[] => {
	const images = (album.items ?? []).filter((item) => item.image);
	if (images.length === 0) return [];
	const count = Math.min(5, images.length);
	const radius = 140; // 环太小会让牌挤成一团，放大半径让牌明显铺开
	const fan: FanImage[] = [];
	for (let i = 0; i < count; i++) {
		const index = count === 1 ? 0 : Math.round((i * (images.length - 1)) / (count - 1));
		const t = i - (count - 1) / 2;
		const theta = -Math.PI / 2 + (i * 2 * Math.PI) / count;
		fan.push({
			image: images[index].image as string,
			alt: images[index].title || album.name,
			x: t * 30,
			y: 8,
			rot: t * 14,
			cx: Math.round(radius * Math.cos(theta)),
			cy: Math.round(radius * Math.sin(theta)),
			wheelRot: (i * 360) / count,
		});
	}
	return fan;
};

const title = __('photos');
---

<BaseLayout title={title}>
	<div id="main-content" class="relative box-border h-full w-9/10 max-w-content transition-[max-width,width] duration-200 ease-in-out sm:w-6/7 md:w-4/5">
		<div class="py-8 sm:py-0">
			<PageTitle title={title} showBorder />
			{
				albums.length > 0 ? (
					<ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
						{albums.map((album) => (
							<li>
								<a
									href={`/photos/${album.slug}/`}
									class="group flex flex-col"
								>
									{
										(() => {
											const fan = fanFor(album);
											return fan.length > 0 ? (
												<div class="album-fan flex justify-center" aria-hidden="true">
													{fan.map((img, i) => (
														<img
															src={img.image}
															alt={img.alt}
															loading="lazy"
															decoding="async"
															style={`--x: ${img.x}px; --y: ${img.y}px; --rot: ${img.rot}deg; --cx: ${img.cx}px; --cy: ${img.cy}px; --wheel-rot: ${img.wheelRot}deg; z-index: ${i + 1};`}
														/>
													))}
												</div>
											) : (
												<div class="flex aspect-[4/3] w-full items-center justify-center bg-rd-gray-100">
													<i class="fa-regular fa-images text-3xl text-rd-gray-900" aria-hidden="true"></i>
												</div>
											);
										})()
									}
									<div class="flex flex-col items-center gap-1 p-4 text-center">
										<span class="text-lg font-bold text-rd-gray-1000 transition-colors group-hover:!text-primary">{album.name}</span>
										<span class="text-xs text-rd-gray-900">{__('photos_count', String(album.items?.length ?? 0))}</span>
										{album.description && <p class="line-clamp-2 text-sm text-rd-gray-900">{album.description}</p>}
									</div>
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="py-10 text-center text-sm text-rd-gray-900">{__('photos_empty')}</p>
				)
			}
		</div>
	</div>
</BaseLayout>

<style>
	/* 子相册封面：默认多图扇形堆叠，悬停时浮起并展开为圆形 */
	.album-fan {
		position: relative;
		height: 11.5rem;
		margin-top: 0.5rem;
		overflow: visible;
	}

	.album-fan:hover {
		z-index: 30;
	}

	.album-fan img {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 8rem;
		height: 10.5rem;
		object-fit: cover;
		border-radius: 0.9rem;
		box-shadow: 0 6px 18px rgb(0 0 0 / 12%);
		transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y))) rotate(var(--rot));
		transform-origin: 50% 50%;
		transition:
			transform 0.45s cubic-bezier(0.34, 1.3, 0.5, 1),
			box-shadow 0.45s ease;
	}

	.album-fan:hover img {
		transform: translate(calc(-50% + var(--cx)), calc(-50% + var(--cy))) rotate(var(--wheel-rot));
		box-shadow: 0 16px 32px rgb(0 0 0 / 22%);
	}
</style>
