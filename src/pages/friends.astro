---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import { themeConfig } from '../config';
import { __ } from '../i18n';
import friendsData from '../data/friends.json';

interface FriendItem {
	name: string;
	link: string;
	description: string;
	avatar?: string;
	thumbnail?: string;
}

interface FriendsCategory {
	links_category: string;
	has_thumbnail?: boolean;
	list: FriendItem[];
}

const friends = friendsData as FriendsCategory[];

const title = __('friends');
const friendsColumn = themeConfig.page_templates.friends_column;
---

<BaseLayout title={title}>
	<div id="main-content" class="relative box-border h-full w-9/10 max-w-content transition-[max-width,width] duration-200 ease-in-out sm:w-6/7 md:w-4/5">
		<div class="flex flex-col">
			<PageTitle title={title} />
			{
				friends.map((category) => (
					<>
						<div class="mt-2 mb-4">
							<h2 class="text-2xl font-bold">{category.links_category}</h2>
						</div>
						{category.has_thumbnail ? (
							<ul class="grid grid-cols-2 mb-6 w-full gap-4">
								{category.list.map((friend) => (
									<li class="group">
										<a href={friend.link} target="_blank" rel="noopener noreferrer">
											<div class="overflow-hidden rounded-2xl border border-rd-gray-alpha-400">
												<div class="h-32 md:h-44">
													{friend.thumbnail && <img class="object-cover w-full h-full" src={friend.thumbnail} alt={friend.name} />}
												</div>
												<div class="flex min-w-0 flex-row items-center gap-1 overflow-hidden sm:gap-2">
													<div class="h-16 w-16 bg-rd-gray-100 flex items-center justify-center">
														{friend.avatar ? (
															<img class="h-16 w-16 max-w-none object-cover" src={friend.avatar} alt={friend.name} onerror="this.style.display='none'" />
														) : (
															<i class="fa-solid fa-user-group"></i>
														)}
													</div>
													<div class="flex flex-col min-w-0">
														<div class="truncate text-lg text-rd-gray-1000 group-hover:!text-primary">{friend.name}</div>
														<div class="truncate text-rd-gray-900">{friend.description}</div>
													</div>
												</div>
											</div>
										</a>
									</li>
								))}
							</ul>
						) : (
							<ul class:list={['grid mb-6 gap-4', friendsColumn === 3 ? 'grid-cols-2 sm:grid-cols-3' : 'grid-cols-2']}>
								{category.list.map((friend) => (
									<li class="group">
										<a href={friend.link} target="_blank" rel="noopener noreferrer">
											<div class="flex flex-row items-center gap-1 sm:gap-2 overflow-hidden min-w-0 rounded-2xl border border-rd-gray-alpha-400">
												<div class="h-16 w-16 bg-rd-gray-100 flex items-center justify-center">
													{friend.avatar ? (
														<img class="h-16 w-16 max-w-none object-cover" src={friend.avatar} alt={friend.name} onerror="this.style.display='none'" />
													) : (
														<i class="fa-solid fa-user-group"></i>
													)}
												</div>
												<div class="flex flex-col min-w-0">
													<div class="truncate text-lg text-rd-gray-1000 group-hover:!text-primary">{friend.name}</div>
													<div class="truncate text-rd-gray-900">{friend.description}</div>
												</div>
											</div>
										</a>
									</li>
								))}
							</ul>
						)}
					</>
				))
			}
		</div>
	</div>
</BaseLayout>
